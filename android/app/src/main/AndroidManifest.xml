<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：反馈邮件与更新页需要能查询到邮件/浏览器 App -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- 重启后补排「跨天重算」闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 课表变更提醒（Android 13+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 「后台稳定运行」：用户主动确认后加入电池优化白名单，保证保持登录的闹钟不被深睡冻结 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".JiaowuApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 桌面小组件点击：jiaowu://schedule 等深链 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jiaowu" />
            </intent-filter>

            <!-- 长按图标快捷方式：课表 / 成绩 / 通知 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- 桌面小组件：跨天重算 + 开机补排闹钟 -->
        <receiver
            android:name=".widget.WidgetAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：下一节课 -->
        <receiver
            android:name=".widget.NextClassWidgetProvider"
            android:label="@string/widget_next_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_info" />
        </receiver>

        <!-- 桌面小组件：今日课程 -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:label="@string/widget_today_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- 桌面小组件：本周课表 -->
        <receiver
            android:name=".widget.WeekWidgetProvider"
            android:label="@string/widget_week_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <!-- 组件内「样式」按钮：循环切换玻璃 / 透明 / 不透明 -->
        <receiver
            android:name=".widget.WidgetStyleReceiver"
            android:exported="false" />

        <!-- 4x4 标题行「下周 › / 本周 ‹」：只翻转被点的那个实例 -->
        <receiver
            android:name=".widget.WidgetWeekSwitchReceiver"
            android:exported="false" />

        <!-- 每小时整点后第 2 分钟重绘一次，让「更新于」的相对时间跟着变 -->
        <receiver
            android:name=".widget.WidgetTimeTickReceiver"
            android:exported="false" />

        <!-- 课表变更：每天 07:10 / 12:50 后台对账 -->
        <receiver
            android:name=".change.ScheduleCheckReceiver"
            android:exported="false" />

        <!-- 课表变更：开机 / 覆盖安装后补排检查闹钟 -->
        <receiver
            android:name=".change.ScheduleBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 保持登录：约每 30 分钟后台维持一次教务会话，仅接受本应用自己的闹钟广播；
             开机 / 覆盖安装后的补排由 change.ScheduleBootReceiver 统一负责 -->
        <receiver
            android:name=".keepalive.SessionKeepAliveReceiver"
            android:exported="false" />

        <activity
            android:name=".SsoLoginActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- 静默换票入口：与普通登录共用 Activity，仅主题与任务栈行为不同 -->
        <activity-alias
            android:name=".SilentSsoLoginActivity"
            android:targetActivity=".SsoLoginActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SsoSilent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
