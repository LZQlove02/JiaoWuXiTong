<?xml version="1.0" encoding="utf-8"?>
<!--
  浅色「液态玻璃」卡片：与深色档同一套结构（半透明本体 + 顶部内发光 + 左边缘高光 + 双层描边），
  只是把参考图的深色玻璃换成白色磨砂，保证浅色主题下文字仍是深色。
  组件拿不到壁纸做实时模糊，用半透明叠加与亮边渐变近似磨砂玻璃的厚度感。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 玻璃本体：白色半透明，顶上略亮 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#80FFFFFF"
                android:centerY="0.4"
                android:endColor="#70FFFFFF"
                android:startColor="#99FFFFFF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 2. 顶部内发光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#12FFFFFF"
                android:centerY="0.16"
                android:endColor="#00FFFFFF"
                android:startColor="#59FFFFFF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 3. 左边缘高光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#0AFFFFFF"
                android:centerX="0.055"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 4. 内描边：1dp，12% 白 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <!-- 5. 外描边：1dp，25% 白 -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
