<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色「液态玻璃」面板：上亮下淡的白色渐变 + 1dp 高光描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#7AFFFFFF"
                android:startColor="#BFFFFFFF"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#E6FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>