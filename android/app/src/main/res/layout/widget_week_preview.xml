<?xml version="1.0" encoding="utf-8"?>
<!-- 添加面板里的预览缩略图，位图来自 scripts/make_widget_preview.py 生成的示例周课表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="本周课表"
            android:textColor="#1A1C1F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="更新于 09:30"
            android:textColor="#8A8F98"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_title_week"
        android:scaleType="fitXY"
        android:src="@drawable/widget_week_preview" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="未阅 32"
        android:textColor="#5F6368"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="最新：关于做好国庆假期教学安排的通知"
        android:textColor="#8A8F98"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="GPA 2.34 · 44.7 学分"
        android:textColor="#5F6368"
        android:textSize="11sp" />
</LinearLayout>