<?xml version="1.0" encoding="utf-8"?>
<!-- 添加面板里的预览缩略图，内容为示例数据，不参与运行时刷新 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="今日课程"
            android:textColor="#1A1C1F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="更新于 09:30"
            android:textColor="#8A8F98"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="10:05"
            android:textColor="#8A8F98"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="形势与政策（三）"
            android:textColor="#1A1C1F"
            android:textSize="12sp" />

        <TextView
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="敏行楼 T1-D302"
            android:textColor="#8A8F98"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="14:30"
            android:textColor="#8A8F98"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="机器学习与深度学习"
            android:textColor="#1A1C1F"
            android:textSize="12sp" />

        <TextView
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="笃行楼 T2-A412"
            android:textColor="#8A8F98"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="下一节 · 16:15 鸿蒙开发技术"
        android:textColor="#5F6368"
        android:textSize="11sp" />
</LinearLayout>