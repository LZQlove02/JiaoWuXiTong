<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片全透明；周课表位图自带半透明衬底，标题与摘要各垫一条淡衬底 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_week_strip_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_strip_light"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/widget_week_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title_week"
            android:textColor="#1A1C1F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_week_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#8A8F98"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_week_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_week_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_title_week"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/widget_week_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#8A8F98"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_week_strip_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_strip_light"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="4dp"
        android:paddingEnd="7dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_week_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#5F6368"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_week_notices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8A8F98"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_week_grades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#5F6368"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>